<Window x:Class="Notaker.WritingSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notaker · Escritura y vocabulario" Width="620" Height="760" MinWidth="520" MinHeight="580" Background="#F7F8F3" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Feedback" Foreground="#7A482D" TextWrapping="Wrap" Margin="0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Probar conexión" Click="Test_Click" x:Name="TestButton" Margin="0,0,10,0"/><Button Content="Guardar" Click="Save_Click" Background="#C1E998" IsDefault="True"/></StackPanel></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Tu forma de escribir" FontSize="27" FontWeight="SemiBold"/>
   <TextBlock Text="Dicta con naturalidad. Conserva lo que quieres decir." Foreground="#738076" Margin="0,8,0,20"/>
   <CheckBox x:Name="CleanBox" Content="Limpiar muletillas y dar formato con DeepSeek" FontWeight="SemiBold"/>
   <TextBlock Text="Al activarlo, se envían la transcripción y tu vocabulario a DeepSeek. El audio se procesa localmente. Requiere una clave API y puede generar cargos en tu cuenta. Sin conexión, conservamos y pegamos el texto original." TextWrapping="Wrap" Foreground="#738076" FontSize="12" Margin="0,4,0,18"/>
   <TextBlock Text="CLAVE API" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <PasswordBox x:Name="ApiKeyBox" Padding="10" FontSize="14" AutomationProperties.Name="Clave API de DeepSeek"/>
   <DockPanel Margin="0,7,0,16"><Button Content="Eliminar clave guardada" Click="RemoveKey_Click" DockPanel.Dock="Right" Padding="8,5" FontSize="10"/><TextBlock x:Name="KeyStatus" Text="La clave se protege con tu cuenta de Windows." FontSize="11" Foreground="#738076" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
   <TextBlock Text="MODELO DE TEXTO" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="ApiModelBox" Padding="10" FontSize="13"/>
   <TextBlock Text="Usamos deepseek-flash por defecto. Puedes indicar otro modelo compatible de tu cuenta." TextWrapping="Wrap" FontSize="11" Foreground="#738076" Margin="0,6,0,22"/>
   <TextBlock Text="Palabras que son tuyas" FontSize="21" FontWeight="SemiBold"/>
   <TextBlock Text="Nombres de clientes, empresas y términos de tu trabajo. Una palabra o expresión por línea; hasta 100 entradas de 80 caracteres. Se usan como pistas, no como sustituciones obligatorias." TextWrapping="Wrap" Foreground="#738076" FontSize="12" Margin="0,8,0,12"/>
   <TextBox x:Name="VocabularyBox" AcceptsReturn="True" Height="145" VerticalScrollBarVisibility="Auto" Padding="10" TextWrapping="Wrap" AutomationProperties.Name="Vocabulario personal"/>
   <CheckBox x:Name="LearnBox" Content="Aprender palabras al corregir dictados en Notaker" Margin="0,14,0,7"/>
   <TextBlock Text="Usa Corregir en el historial o en la bandeja. Las palabras nuevas de esa corrección se añaden a este vocabulario; puedes quitarlas aquí. No se leen tus documentos ni las correcciones que haces en otras aplicaciones." TextWrapping="Wrap" Foreground="#738076" FontSize="12"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
