<Window x:Class="Notaker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notaker — Dictado" Width="1080" Height="800" MinWidth="900" MinHeight="650" Background="#0E1020" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#131527" BorderBrush="#292D47" BorderThickness="0,0,1,0">
   <Grid Margin="24,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="◉  notaker" FontSize="26" FontWeight="Bold"/><TextBlock Text="TU VOZ, POR ESCRITO" FontSize="9" Foreground="#A5ACCB" Margin="2,10,0,34"/><Border Background="#30234C" CornerRadius="8" Padding="14,12"><TextBlock Text="✦   Dictado" FontWeight="SemiBold"/></Border><TextBlock Text="Español + English" Margin="14,20,0,0" Foreground="#A5ACCB" FontSize="12"/></StackPanel>
    <StackPanel Grid.Row="2"><Border Background="#1D2140" Padding="12" CornerRadius="10"><StackPanel><TextBlock Text="●  Procesamiento local" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="PrivacyLabel" Text="Tu audio se queda&#10;en este equipo." FontSize="12" Foreground="#A5ACCB" Margin="0,7,0,0" LineHeight="18"/></StackPanel></Border><Button Content="Estadísticas  ↗" Click="Statistics_Click" FontSize="12" Padding="10,10" Margin="0,14,0,0"/><Button Content="Buscar actualizaciones ↗" Click="Update_Click" FontSize="11" Padding="10,9" Margin="0,14,0,0"/><TextBlock x:Name="AppVersionLabel" Text="NOTAKER / WINDOWS" FontSize="9" Foreground="#929BBE" Margin="0,20,0,0"/></StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="38,30,38,30">
    <DockPanel><TextBlock Text="ESPACIO PERSONAL" Foreground="#A5ACCB" FontSize="10" VerticalAlignment="Center"/><Button Content="Ocultar a la bandeja  ↗" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Hide_Click" FontSize="11" Background="Transparent" Padding="10,6"/></DockPanel>
    <TextBlock Text="Habla. El texto te sigue." FontSize="34" FontWeight="SemiBold" Margin="0,23,0,9"/>
    <TextBlock Text="De una idea en voz alta a palabras en cualquier aplicación." FontSize="14" Foreground="#A5ACCB"/>
    <Border Background="{StaticResource HeroGradient}" CornerRadius="16" Padding="26" Margin="0,26,0,22">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="StatusHeading" Text="Prepara tu primer dictado" Foreground="#F2EEFF" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Descarga el modelo de voz una sola vez para empezar." Foreground="#B9B5D6" TextWrapping="Wrap" Margin="0,9,20,14" FontSize="13"/><TextBlock x:Name="ShortcutLabel" Text="Ctrl + Alt + Espacio" Foreground="#9671F5" FontSize="14" FontWeight="SemiBold"/><ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,16,20,0" Visibility="Collapsed" Foreground="#9671F5"/><TextBlock x:Name="LiveText" Foreground="#9671F5" FontSize="12" Margin="0,10,0,0"/></StackPanel>
      <Button x:Name="SetupButton" Grid.Column="1" Content="Descargar modelo ↓" Background="#9671F5" VerticalAlignment="Center" Click="Setup_Click"/>
     </Grid>
    </Border>
    <Grid x:Name="SettingsPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="MODELO DE VOZ" FontSize="10" FontWeight="SemiBold" Foreground="#A5ACCB" Margin="0,0,0,9"/><ComboBox x:Name="ModelBox" SelectionChanged="Model_Changed" AutomationProperties.Name="Modelo de voz"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock x:Name="ModelDetails" FontSize="11" Foreground="#A5ACCB" TextWrapping="Wrap" Margin="0,8,0,14"/><CheckBox x:Name="GpuBox" Content="Acelerar con GPU compatible" Margin="0,0,0,14" Click="Gpu_Changed"/><TextBlock Text="IDIOMA DEL DICTADO" FontSize="10" FontWeight="SemiBold" Foreground="#A5ACCB" Margin="0,0,0,9"/><ComboBox x:Name="LanguageBox" SelectionChanged="Settings_Changed" AutomationProperties.Name="Idioma"><ComboBoxItem Content="Automático · español / inglés"/><ComboBoxItem Content="Español"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Español + English · Spanglish"/></ComboBox><TextBlock Text="Spanglish aporta contexto bilingüe; no solicita traducción." FontSize="11" Foreground="#A5ACCB" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="MICRÓFONO" FontSize="10" FontWeight="SemiBold" Foreground="#A5ACCB" Margin="0,18,0,9"/><ComboBox x:Name="MicrophoneBox" SelectionChanged="Settings_Changed" AutomationProperties.Name="Micrófono"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="ATAJO GLOBAL" FontSize="10" FontWeight="SemiBold" Foreground="#A5ACCB" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HotkeyBox" IsReadOnly="True" Padding="10,8" FontSize="13" VerticalContentAlignment="Center" AutomationProperties.Name="Capturar atajo de dictado" GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus" PreviewKeyDown="Hotkey_KeyDown"/><Button x:Name="SaveHotkeyButton" Grid.Column="1" Content="Guardar" Margin="8,0,0,0" Padding="12,8" IsEnabled="False" Click="SaveHotkey_Click"/></Grid><TextBlock x:Name="HotkeyHint" Text="Haz clic y pulsa una combinación de teclas." TextWrapping="Wrap" FontSize="11" Foreground="#A5ACCB" Margin="0,7,0,0"/><CheckBox x:Name="PasteBox" Content="Pegar automáticamente al terminar" Margin="0,20,0,7" Click="Preference_Click"/><CheckBox x:Name="HistoryBox" Content="Guardar historial en este equipo" Click="Preference_Click"/></StackPanel>
    </Grid>
    <Button Content="Escritura con IA y vocabulario personal  →" HorizontalAlignment="Left" Margin="0,18,0,0" Click="WritingSettings_Click" IsEnabled="{Binding IsEnabled, ElementName=SettingsPanel}"/><Border Background="#191C32" CornerRadius="10" Padding="16,13" Margin="0,22,0,24"><TextBlock FontSize="12" Foreground="#ADB5D7" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="01  Sitúa el cursor  "/><Run Text="donde quieras escribir.  "/><Run FontWeight="SemiBold" Text="02  Pulsa el atajo  "/><Run Text="y habla.  "/><Run FontWeight="SemiBold" Text="03  Repite el atajo  "/><Run Text="para transcribir y pegar."/></TextBlock></Border>
    <DockPanel Margin="0,0,0,12"><Button Content="Borrar historial" DockPanel.Dock="Right" Click="Clear_Click" FontSize="11" Padding="10,6" Background="Transparent"/><TextBlock Text="Tus últimos dictados" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="EmptyHistory" Text="Un espacio para tus próximas ideas. Tus dictados aparecerán aquí." TextWrapping="Wrap" Foreground="#9BA6CA" Margin="0,16,0,18" FontSize="13"/>
    <ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#191C32" BorderBrush="#30354F" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,10"><StackPanel><DockPanel><Button Content="Corregir" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,5" FontSize="11" Click="Correct_Click"/><Button Content="Copiar" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,5" FontSize="11" Click="Copy_Click"/><TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#9BA6CA" VerticalAlignment="Center"/></DockPanel><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#DFE4FF" Margin="0,10,0,0" MaxHeight="180" VerticalScrollBarVisibility="Auto"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Audio local · Vocabulario personal · Limpieza con IA opcional" FontSize="11" Foreground="#929BBE" Margin="0,18,0,0"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
